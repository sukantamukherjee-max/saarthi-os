# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real keys.

# --- Supabase ---
# Project Settings → API. The URL and anon key are safe to expose to the
# browser (Vite inlines anything prefixed VITE_ into the client bundle) —
# access to real data is enforced by Row-Level Security, not by hiding these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service role key — SECRET. Server-side only (Netlify Functions). Bypasses
# Row-Level Security entirely, so it must never reach the browser bundle
# (that's why it has no VITE_ prefix — Vite won't inline it).
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data (SECRET — server-side only, used by netlify/functions/market-quotes) ---
FINNHUB_API_KEY=

# --- FX data (SECRET — server-side only, used by netlify/functions/fx-rates) ---
EXCHANGERATE_API_KEY=

# --- Google Gemini API (SECRET — server-side only) ---
# Free tier. Used by netlify/functions/parse-statement (document/screenshot
# extraction) and netlify/functions/narrate-recommendation (AI Advisor mode).
GEMINI_API_KEY=
